% ASTRIX rules-5 independent kinematics reference, NASA GMAT R2025a.
% Point masses with ASTRIX constants. No third-body forces, drag, ascent,
% lunar ephemeris, SOI switching, spacecraft resources or flight qualification.
GMAT Earth.Mu = 398600;
GMAT Luna.Mu = 4902.8;
Create CoordinateSystem MoonFrame;
GMAT MoonFrame.Origin = Luna;
GMAT MoonFrame.Axes = MJ2000Eq;
Create Spacecraft Raise Escape MoonOrbit;
GMAT Raise.DateFormat = UTCGregorian;
GMAT Raise.Epoch = '15 Nov 2026 00:00:00.000';
GMAT Raise.CoordinateSystem = EarthMJ2000Eq;
GMAT Raise.DisplayStateType = Cartesian;
GMAT Raise.X = 6578.137;
GMAT Raise.Y = 0;
GMAT Raise.Z = 0;
GMAT Raise.VX = 0;
GMAT Raise.VY = 7.784257434611812;
GMAT Raise.VZ = 0;
GMAT Escape = Raise;
GMAT Escape.VY = 11.3;
GMAT MoonOrbit.DateFormat = UTCGregorian;
GMAT MoonOrbit.Epoch = '15 Nov 2026 00:00:00.000';
GMAT MoonOrbit.CoordinateSystem = MoonFrame;
GMAT MoonOrbit.DisplayStateType = Cartesian;
GMAT MoonOrbit.X = 1837.4;
GMAT MoonOrbit.Y = 0;
GMAT MoonOrbit.Z = 0;
GMAT MoonOrbit.VX = 0;
GMAT MoonOrbit.VY = 1.6335041143928368;
GMAT MoonOrbit.VZ = 0;
Create ForceModel EarthForce MoonForce;
GMAT EarthForce.CentralBody = Earth;
GMAT EarthForce.PrimaryBodies = {};
GMAT EarthForce.PointMasses = {Earth};
GMAT EarthForce.Drag = None;
GMAT EarthForce.SRP = Off;
GMAT MoonForce.CentralBody = Luna;
GMAT MoonForce.PrimaryBodies = {};
GMAT MoonForce.PointMasses = {Luna};
GMAT MoonForce.Drag = None;
GMAT MoonForce.SRP = Off;
Create Propagator EarthProp MoonProp;
GMAT EarthProp.FM = EarthForce;
GMAT EarthProp.Type = RungeKutta89;
GMAT EarthProp.Accuracy = 1e-12;
GMAT EarthProp.MaxStep = 30;
GMAT MoonProp.FM = MoonForce;
GMAT MoonProp.Type = RungeKutta89;
GMAT MoonProp.Accuracy = 1e-12;
GMAT MoonProp.MaxStep = 10;
Create ImpulsiveBurn RaiseApo Circularize;
GMAT RaiseApo.CoordinateSystem = Local;
GMAT RaiseApo.Origin = Earth;
GMAT RaiseApo.Axes = VNB;
GMAT RaiseApo.Element1 = 2.4545860090817744;
GMAT RaiseApo.DecrementMass = false;
GMAT Circularize.CoordinateSystem = Local;
GMAT Circularize.Origin = Earth;
GMAT Circularize.Axes = VNB;
GMAT Circularize.Element1 = 1.4772709110334405;
GMAT Circularize.DecrementMass = false;
Create ReportFile RaiseResult EscapeResult MoonResult;
GMAT RaiseResult.Filename = 'astrix-raise-reference.txt';
GMAT RaiseResult.Precision = 16;
GMAT EscapeResult.Filename = 'astrix-escape-reference.txt';
GMAT EscapeResult.Precision = 16;
GMAT MoonResult.Filename = 'astrix-moon-reference.txt';
GMAT MoonResult.Precision = 16;
BeginMissionSequence;
Maneuver RaiseApo(Raise);
Propagate EarthProp(Raise) {Raise.ElapsedSecs = 18931.930961285834};
Report RaiseResult Raise.ElapsedSecs Raise.EarthMJ2000Eq.X Raise.EarthMJ2000Eq.Y Raise.EarthMJ2000Eq.Z Raise.EarthMJ2000Eq.VX Raise.EarthMJ2000Eq.VY Raise.EarthMJ2000Eq.VZ;
Maneuver Circularize(Raise);
Report RaiseResult Raise.ElapsedSecs Raise.EarthMJ2000Eq.X Raise.EarthMJ2000Eq.Y Raise.EarthMJ2000Eq.Z Raise.EarthMJ2000Eq.VX Raise.EarthMJ2000Eq.VY Raise.EarthMJ2000Eq.VZ;
Propagate EarthProp(Escape) {Escape.ElapsedSecs = 86400};
Report EscapeResult Escape.ElapsedSecs Escape.EarthMJ2000Eq.X Escape.EarthMJ2000Eq.Y Escape.EarthMJ2000Eq.Z Escape.EarthMJ2000Eq.VX Escape.EarthMJ2000Eq.VY Escape.EarthMJ2000Eq.VZ;
Propagate MoonProp(MoonOrbit) {MoonOrbit.ElapsedSecs = 7067.459813349092};
Report MoonResult MoonOrbit.ElapsedSecs MoonOrbit.MoonFrame.X MoonOrbit.MoonFrame.Y MoonOrbit.MoonFrame.Z MoonOrbit.MoonFrame.VX MoonOrbit.MoonFrame.VY MoonOrbit.MoonFrame.VZ;
