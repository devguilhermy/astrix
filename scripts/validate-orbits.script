% ASTRIX independent reference calculation, NASA GMAT R2025a.
% Two-body force models, matching the game's deliberate omissions.
% Earth GMAT default mu may differ slightly from rounded NASA fact-sheet mu.
Create Spacecraft S400 S420 S500 S600 HTransfer MarsCapture;
GMAT S400.DateFormat = UTCGregorian;
GMAT S400.Epoch = '01 May 2024 00:00:00.000';
GMAT S400.CoordinateSystem = EarthMJ2000Eq;
GMAT S400.DisplayStateType = Keplerian;
GMAT S400.SMA = 6778.137;
GMAT S400.ECC = 0;
GMAT S400.INC = 51.6;
GMAT S400.RAAN = 0;
GMAT S400.AOP = 0;
GMAT S400.TA = 0;
GMAT S420 = S400;
GMAT S420.SMA = 6798.137;
GMAT S500 = S400;
GMAT S500.SMA = 6878.137;
GMAT S600 = S400;
GMAT S600.SMA = 6978.137;
Create CoordinateSystem SunFrame MarsFrame;
GMAT SunFrame.Origin = Sun;
GMAT SunFrame.Axes = MJ2000Eq;
GMAT MarsFrame.Origin = Mars;
GMAT MarsFrame.Axes = MJ2000Eq;
GMAT HTransfer.DateFormat = UTCGregorian;
GMAT HTransfer.Epoch = '01 May 2024 00:00:00.000';
GMAT HTransfer.CoordinateSystem = SunFrame;
GMAT HTransfer.DisplayStateType = Keplerian;
GMAT HTransfer.SMA = 188777000;
GMAT HTransfer.ECC = 0.20754117291831103;
GMAT HTransfer.INC = 0;
GMAT HTransfer.RAAN = 0;
GMAT HTransfer.AOP = 0;
GMAT HTransfer.TA = 0;
GMAT MarsCapture.DateFormat = UTCGregorian;
GMAT MarsCapture.Epoch = '01 May 2024 00:00:00.000';
GMAT MarsCapture.CoordinateSystem = MarsFrame;
GMAT MarsCapture.DisplayStateType = Keplerian;
GMAT MarsCapture.SMA = 20096.2;
GMAT MarsCapture.ECC = 0.8110986156586818;
GMAT MarsCapture.INC = 0;
GMAT MarsCapture.RAAN = 0;
GMAT MarsCapture.AOP = 0;
GMAT MarsCapture.TA = 0;
Create ForceModel SunTwoBody;
GMAT SunTwoBody.CentralBody = Sun;
GMAT SunTwoBody.PrimaryBodies = {};
GMAT SunTwoBody.PointMasses = {Sun};
GMAT SunTwoBody.Drag = None;
GMAT SunTwoBody.SRP = Off;
Create Propagator SunProp;
GMAT SunProp.FM = SunTwoBody;
GMAT SunProp.Type = RungeKutta89;
GMAT SunProp.Accuracy = 1e-12;
GMAT SunProp.MaxStep = 86400;
Create ReportFile Results;
GMAT Results.Filename = 'astrix-gmat-results.txt';
GMAT Results.Precision = 16;
GMAT Results.WriteHeaders = true;
GMAT Results.ColumnWidth = 28;
BeginMissionSequence;
Report Results S400.Earth.OrbitPeriod S420.Earth.OrbitPeriod S500.Earth.OrbitPeriod S600.Earth.OrbitPeriod S420.Earth.VelPeriapsis;
Report Results HTransfer.Sun.OrbitPeriod HTransfer.Sun.VelPeriapsis HTransfer.Sun.VelApoapsis;
Report Results MarsCapture.Mars.OrbitPeriod MarsCapture.Mars.VelPeriapsis;
Propagate SunProp(HTransfer) {HTransfer.Sun.Apoapsis};
Report Results HTransfer.ElapsedDays HTransfer.Sun.RMAG;
