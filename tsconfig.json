{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "baseUrl": ".",
    "paths": {
      "@astrix/core": [
        "packages/core/src/index.ts"
      ],
      "@astrix/core/*": [
        "packages/core/src/*"
      ],
      "@astrix/data": [
        "packages/data/src/index.ts"
      ],
      "@astrix/data/*": [
        "packages/data/src/*"
      ]
    }
  },
  "include": [
    "packages",
    "apps/web/src",
    "apps/web/vite.config.ts",
    "scripts"
  ]
}
